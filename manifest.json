{
  "manifest_version": 3,
  "name": "Skyward+ — Gradebook, but legible",
  "version": "1.0.0",
  "description": "Reorganizes Skyward grades by class, shows class averages next to every score, weighted category math, what-if grades, and trends.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.iscorp.com/*",
    "*://*.skyward.com/*",
    "*://*/scripts/wsisa.dll/*",
    "*://*/skyward/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "Skyward+",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.iscorp.com/*",
        "*://*.skyward.com/*",
        "*://*/scripts/wsisa.dll/*",
        "*://*/skyward/*"
      ],
      "js": [
        "src/lib/util.js",
        "src/lib/model.js",
        "src/lib/storage.js",
        "src/lib/parse.js",
        "src/ui/app.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/ui/app.css", "dashboard/dashboard.html", "icons/*"],
      "matches": ["*://*/*"]
    }
  ]
}
